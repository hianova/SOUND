; SOUND v3.0.0 — Pure QF_LIA Belnap Bilattice Monotonicity & Hohfeld Duty Exclusivity
(set-logic QF_LIA)

(declare-const tx Int) (declare-const fx Int)
(declare-const ty Int) (declare-const fy Int)
(declare-const tz Int) (declare-const fz Int)

; CHECK 1: Anti-vacuity for Belnap 4-valued bilattice knowledge ordering (expect SAT)
(push)
(assert (or (= tx 0) (= tx 1))) (assert (or (= fx 0) (= fx 1)))
(assert (or (= ty 0) (= ty 1))) (assert (or (= fy 0) (= fy 1)))
(assert (or (= tz 0) (= tz 1))) (assert (or (= fz 0) (= fz 1)))
(assert (and (<= tx ty) (<= fx fy)))
(assert (not (and (= tx ty) (= fx fy))))
(check-sat)
(pop)

; CHECK 2: Belnap knowledge-order join monotonicity (expect UNSAT)
(push)
(assert (and (or (= tx 0) (= tx 1)) (or (= fx 0) (= fx 1))))
(assert (and (or (= ty 0) (= ty 1)) (or (= fy 0) (= fy 1))))
(assert (and (or (= tz 0) (= tz 1)) (or (= fz 0) (= fz 1))))
(assert (and (<= tx ty) (<= fx fy)))
(assert (or
  (> (ite (>= tx tz) tx tz) (ite (>= ty tz) ty tz))
  (> (ite (>= fx fz) fx fz) (ite (>= fy fz) fy fz))))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — non-monotone defeasible retraction violates <=_k (expect SAT)
(push)
(assert (= tx 1)) (assert (= fx 0))
(assert (= ty 0)) (assert (= fy 1))
(assert (> tx ty))
(check-sat)
(pop)

; CHECK 4: Hohfeldian norm exclusivity — established and defeated cannot both hold (expect UNSAT)
(declare-const est Int) (declare-const def_flag Int)
(push)
(assert (or (= est 0) (= est 1)))
(assert (or (= def_flag 0) (= def_flag 1)))
(assert (<= (+ est def_flag) 1))
(assert (and (= est 1) (= def_flag 1)))
(check-sat)
(pop)
