    },
    {
      "id": "std_ias37_cont_asset",
      "role": "statute_root",
      "sort": "normative",
      "evid": "enacted_norm",
      "description": "IAS 37 §31-35：或有資產不得認列，唯流入幾乎確定（virtually certain）始認列資產",
      "clauses": [[]]
    },
    {
