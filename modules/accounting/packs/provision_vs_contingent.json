{
  "pack_id": "provision_vs_contingent",
  "domain": "accounting",
  "jurisdiction": "TW",
  "standard": "IAS 37 負債準備、或有負債及或有資產、IAS 16 不動產廠房及設備",
  "version": "1.0.0",
  "title": "會計學基礎：負債準備、或有負債/資產揭露門檻、資本支出與收益支出區分",
