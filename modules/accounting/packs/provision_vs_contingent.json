      "clauses": [[]]
    },
    {
      "id": "std_ias37_contingent",
      "role": "statute_root",
      "sort": "normative",
      "evid": "enacted_norm",
      "description": "IAS 37 §27-28：或有負債不得認列於資產負債表，除流出可能性極微外應附註揭露",
      "clauses": [[]]
    },
    {
      "id": "std_ias37_remote",
      "role": "statute_root",
      "sort": "normative",
      "evid": "enacted_norm",
      "description": "IAS 37 §28：經濟資源流出可能性極微（remote）無須入帳亦無須揭露",
