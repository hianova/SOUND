{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound.local/modules/common/proposer_contract.json",
  "title": "SOUND Stage-2 Multilingual MCQ Proposer Output Contract",
  "description": "Vendor-agnostic structured JSON schema emitted by an external LLM Proposer when normalizing raw Traditional Chinese or English Taxation/Accounting MCQ text against a Domain Topic Pack before deterministic verification via build/sound.",
  "system_instructions": [
    "You are a thin semantic-intent aligner for SOUND domain packs (Taxation and Accounting).",
    "Do NOT solve the question, do NOT compute numbers, and do NOT guess which option is correct.",
    "Map the stem and each option (A/B/C/D) strictly onto node IDs declared in the provided Topic Pack catalog and its aliases.",
    "Preserve stem polarity verbatim as 'select_correct' or 'select_incorrect'.",
    "Set universal_scope=true whenever an option makes an unqualified universal generalization without statutory exception qualifiers (e.g., 一律、皆、均不得、無例外).",
    "Populate unverified_facts when a required premise is unsubstantiated, merely oral/projected, or assumed without evidence.",
    "Use claim.kind='hume_leap' when an option derives a normative/institutional duty directly from purely factual premises without citing an enacted statute/standard root."
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "stem", "stem_polarity", "stem_facts", "options"],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,48}$"
    },
    "stem": {
      "type": "string",
      "minLength": 1
    },
    "stem_polarity": {
      "type": "string",
      "enum": ["select_correct", "select_incorrect"]
    },
    "stem_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]{1,24}$"
      },
      "uniqueItems": true
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text", "scenario_facts", "claim"],
        "properties": {
          "label": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "scenario_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,24}$"
            },
            "uniqueItems": true
          },
          "unverified_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,24}$"
            },
            "uniqueItems": true
          },
          "universal_scope": {
            "type": "boolean",
            "default": false
          },
          "explicit_exception_scoped": {
            "type": "boolean",
            "default": false
          },
          "claim": {
            "type": "object",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "target"],
                "properties": {
                  "kind": { "const": "assert_node" },
                  "target": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,24}$" },
                  "expect_status": {
                    "type": "string",
                    "enum": ["established", "defeated", "conflictUndecided", "penumbraOpen"],
                    "default": "established"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "from_facts"],
                "properties": {
                  "kind": { "const": "hume_leap" },
                  "from_facts": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,24}$" }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "requires"],
                "properties": {
                  "kind": { "const": "composite_claim" },
                  "requires": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,24}$" }
                  },
                  "attacked_by": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,24}$" }
                  },
                  "counterpart_of": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,24}$" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
